# Frontend settings. These are built into the website at build time (Vite), so they are
# public: never put a secret key here. Rebuild after changing them.

# [REQUIRED] Supabase project URL and anon (public) key: Supabase → Project Settings → API
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# [REQUIRED] Backend address, no trailing slash. If missing, the site calls localhost.
VITE_API_BASE_URL=http://localhost:8000

# [OPTIONAL] true = verify phone by SMS code at registration (match REQUIRE_PHONE_VERIFIED)
VITE_REQUIRE_PHONE_OTP=false

# [OPTIONAL] ESG testing mode: hide departments and stakeholder types from users.
# Set to false to show all departments (match SINGLE_DEPARTMENT on the backend).
VITE_SINGLE_DEPARTMENT_MODE=true
