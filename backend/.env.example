# Backend settings. Copy to backend/.env for local runs; on a server, set the same
# names as environment variables. [REQUIRED] values must be set; [OPTIONAL] ones can
# be left out and the default (shown) is used.

# === Supabase ===
# [REQUIRED] Project URL: Supabase → Project Settings → API
SUPABASE_URL=your-supabase-url
# [REQUIRED] anon (public) key, used to check users' login tokens
SUPABASE_KEY=your-supabase-anon-key
# [REQUIRED] service_role key. Secret: backend only, never in the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === AI model (chatbot and complaint triage) ===
# [REQUIRED] Groq API key: console.groq.com
GROQ_API_KEY=your-groq-api-key
# [OPTIONAL] groq (default) or ollama (a local model server, for development)
LLM_PROVIDER=groq
# [OPTIONAL] Groq model name
GROQ_MODEL=qwen/qwen3.8-27b
# [OPTIONAL] Only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=4096

# === Site address ===
# [REQUIRED] Website address(es), comma-separated. Used for CORS and the links in invite emails
FRONTEND_URL=http://localhost:5173

# === Policy search: hosted embeddings ===
# [REQUIRED on servers without PyTorch] The embedding service from deploy/hf-embed-space.
# Without them the policy chatbot falls back to keyword-only search (weaker answers).
EMBED_URL=
EMBED_KEY=
# [REQUIRED with EMBED_URL] Hugging Face token, so embedding calls use your account's
# ZeroGPU quota instead of the small anonymous one
HF_TOKEN=

# === Email (staff invites, password resets, escalation alerts) ===
# [REQUIRED] Brevo HTTP API (works on hosts that block SMTP ports, such as Render)
BREVO_API_KEY=
# [REQUIRED] Sender address, verified in Brevo
EMAIL_FROM=verified-sender@example.com
# [OPTIONAL] Sender name
EMAIL_FROM_NAME=Puravankara GRM
# [OPTIONAL] SMTP instead of Brevo, used only when BREVO_API_KEY is empty
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com

# === Phone OTP at registration ===
# [OPTIONAL] true = phone must be verified by SMS code before filing complaints
REQUIRE_PHONE_VERIFIED=false
# [OPTIONAL] true = OTP codes are printed in the backend log instead of sent (testing only)
OTP_DEV_MODE=false
# [OPTIONAL] Twilio, only needed when sending real SMS codes
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1234567890

# === ESG testing mode ===
# [OPTIONAL] Every complaint goes to this department. Leave empty to use all 6 departments.
SINGLE_DEPARTMENT=ESG

# === One-time admin setup (backend/bootstrap_super_admin.py only) ===
# [OPTIONAL] Set these only while running the script once, then remove them.
SUPER_ADMIN_EMAIL=superadmin@yourcompany.com
SUPER_ADMIN_PASSWORD=ChangeThisImmediately!123
# Password given to the seeded department staff logins (L1/L2/L3/HEAD per department)
SEED_ADMIN_PASSWORD=
